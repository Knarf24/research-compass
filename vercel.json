{
  "buildCommand": "sh build_site.sh",
  "outputDirectory": "_site",
  "installCommand": "true",
  "framework": null,
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(sw.js|config.js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
